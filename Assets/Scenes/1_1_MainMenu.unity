  skills:
  - id: magic_bolt
    name: "Tia S\xE9t Ma Ph\xE1p"
    category: 1
    icon: {fileID: 21300000, guid: ac4bcfcd2cfca486d8158a1572a5084b, type: 3}
    tagText: "[ PH\xC9P - C\u1ED4 THU\u1EACT ]"
    maxLevel: 5
    overview: "B\u1EAFn c\xE1c tia s\xE9t ma ph\xE1p t\u1ED1c \u0111\u1ED9 cao v\xE0o
      m\u1EE5c ti\xEAu g\u1EA7n nh\u1EA5t. Xuy\xEAn ph\xE1 k\u1EBB \u0111\u1ECBch
      v\xE0 n\xE2ng c\u1EA5p b\u1EAFn \u0111a tia khi \u0111\u1EA1t ti\u1EBFn h\xF3a
      t\u1ED1i th\u01B0\u1EE3ng."
    levels:
    - level: 1
      title: "M\u1EDF Kh\xF3a"
      description: "B\u1EAFn 1 Tia S\xE9t Ma Ph\xE1p g\xE2y 20 s\xE1t th\u01B0\u01A1ng
        ph\xE9p. H\u1ED3i chi\xEAu: 0.8s."
      isUltimate: 0
    - level: 2
      title: "C\u01B0\u1EDDng H\xF3a"
      description: "+10 S\xE1t th\u01B0\u01A1ng ph\xE9p v\xE0 +15% v\u1EADn t\u1ED1c
        bay c\u1EE7a tia s\xE9t."
      isUltimate: 0
    - level: 3
      title: "Thi Tri\u1EC3n Nhanh"
      description: "Gi\u1EA3m th\u1EDDi gian h\u1ED3i chi\xEAu c\xF2n 0.55s (b\u1EAFn
        nhanh h\u01A1n 30%)."
      isUltimate: 0
    - level: 4
      title: "B\u1EAFn Tam H\u01B0\u1EDBng"
      description: "B\u1EAFn 3 Tia S\xE9t Ma Ph\xE1p c\xF9ng l\xFAc theo h\xECnh
        n\xF3n ph\xEDa tr\u01B0\u1EDBc."
      isUltimate: 0
    - level: 5
      title: "Qu\xE1 T\u1EA3i C\u1ED5 Thu\u1EADt"
      description: "TI\u1EBEN H\xD3A: Tia s\xE9t xuy\xEAn qua 2 qu\xE1i v\u1EADt
        v\xE0 +13 s\xE1t th\u01B0\u01A1ng uy l\u1EF1c!"
      isUltimate: 1
  - id: fireball
    name: "Qu\u1EA3 C\u1EA7u L\u1EEDa"
    category: 1
    icon: {fileID: 21300000, guid: b9c9586ac1ca94ae2b9ce7f24ab485f9, type: 3}
    tagText: "[ PH\xC9P - N\u1ED4 DI\u1EC6N R\u1ED8NG ]"
    maxLevel: 5
    overview: "Ph\xF3ng qu\u1EA3 c\u1EA7u l\u1EEDa kh\u1ED5ng l\u1ED3 ph\xE1t n\u1ED5
      khi va ch\u1EA1m, qu\xE9t s\u1EA1ch c\xE1c c\u1EE5m qu\xE1i v\u1EADt \u0111\xF4ng
      \u0111\u1EA3o v\u1EDBi s\xE1t th\u01B0\u01A1ng di\u1EC7n r\u1ED9ng h\u1EE7y
      di\u1EC7t."
    levels:
    - level: 1
      title: "M\u1EDF Kh\xF3a"
      description: "Ph\xF3ng qu\u1EA3 c\u1EA7u l\u1EEDa g\xE2y 45 s\xE1t th\u01B0\u01A1ng
        n\u1ED5 di\u1EC7n r\u1ED9ng. H\u1ED3i chi\xEAu: 1.8s."
      isUltimate: 0
    - level: 2
      title: "B\xE1n K\xEDnh N\u1ED5"
      description: "+20 S\xE1t th\u01B0\u01A1ng n\u1ED5 v\xE0 +30% di\u1EC7n t\xEDch
        v\u1EE5 n\u1ED5."
      isUltimate: 0
    - level: 3
      title: "Song H\u1ECFa C\u1EA7u"
      description: "B\u1EAFn 2 Qu\u1EA3 C\u1EA7u L\u1EEDa \u0111\u1ED3ng th\u1EDDi
        nh\u1EAFm v\xE0o c\xE1c v\u1ECB tr\xED kh\xE1c nhau."
      isUltimate: 0
    - level: 4
      title: "Gia T\u1ED1c H\u1ED3i Ph\u1EE5c"
      description: "Gi\u1EA3m th\u1EDDi gian h\u1ED3i chi\xEAu c\xF2n 1.35s v\xE0
